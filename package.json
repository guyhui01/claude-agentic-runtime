{
  "name": "claude-agentic-runtime",
  "version": "0.13.0",
  "description": "Agentic runtime executing the claude-agents catalog (read-only) through the Claude Agent SDK.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Guy HUI-BON-HOA",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "tsc -p scripts/tsconfig.json && node .tools-build/scripts/measure-manifest.js",
    "measure:denials": "tsc -p scripts/tsconfig.json && node .tools-build/scripts/measure-denials.js",
    "verify:denials": "tsc -p scripts/tsconfig.json && node .tools-build/scripts/verify-denial-policy.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.232",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@hono/node-server": "^2.0.5"
  }
}
